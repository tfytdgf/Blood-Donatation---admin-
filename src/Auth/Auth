import { createContext, useContext, useEffect, useState } from 'react';
import { api, clearSession, getSession, saveSession } from './api';
import { hasPerm } from './permissions';

const AuthContext = createContext(null);

export function AuthProvider({ children }) {
  const [user, setUser] = useState(getSession);
  const [notice, setNotice] = useState('');

  useEffect(() => {
    const onExpired = () => {
      setUser(null);
      setNotice('Your session expired. Sign in again to continue.');
    };
    window.addEventListener('auth:expired', onExpired);
    return () => window.removeEventListener('auth:expired', onExpired);
  }, []);

  function finish({ token, user: u }) {
    saveSession(token, u);
    setNotice('');
    setUser(u);
  }

  // Returns { challenge } when the account needs a second step, otherwise signs in.
  async function login(email, password) {
    const res = await api.login(email, password);
    if (res.twoFactor) return { challenge: res.challenge };
    finish(res);
    return null;
  }

  async function confirmCode(challenge, code) {
    finish(await api.verifyCode(challenge, code));
  }

  function logout() {
    clearSession();
    setNotice('');
    setUser(null);
  }

  function updateUser(patch) {
    const next = { ...user, ...patch };
    saveSession(localStorage.getItem('admin_token'), next);
    setUser(next);
  }

  const can = (perm) => Boolean(user) && hasPerm(user.role, perm);

  return <AuthContext.Provider value={{ user, notice, login, confirmCode, logout, updateUser, can }}>{children}</AuthContext.Provider>;
}

export const useAuth = () => useContext(AuthContext);