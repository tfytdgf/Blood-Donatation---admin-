# Leave empty to run on the built-in sample data (src/mock.js).
# Set it to your backend to go live, e.g. https://api.yourdomain.org/v1
REACT_APP_API_URL=

# Optional: WebSocket address for instant emergency alerts, e.g. wss://api.yourdomain.org/live
# Leave empty and the app checks for new requests every 30 seconds instead.
REACT_APP_WS_URL=
